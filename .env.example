# =============================================================
# TechSAS Enterprise Stack — Environment Variables
# Copy this to .env and fill in all values before deploying
# =============================================================

# ── Server ────────────────────────────────────────────────────
SERVER_IP=147.93.169.215
BASE_DOMAIN=yourdomain.com          # e.g. techsas.in

# ── Traefik ───────────────────────────────────────────────────
ACME_EMAIL=admin@yourdomain.com

# ── PostgreSQL (shared) ───────────────────────────────────────
POSTGRES_PASSWORD=changeme_postgres_strong_password

# ── Redis (shared) ────────────────────────────────────────────
REDIS_PASSWORD=changeme_redis_strong_password

# ── MongoDB (shared) ──────────────────────────────────────────
MONGO_ROOT_PASSWORD=changeme_mongo_strong_password

# ── MinIO ─────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme_minio_strong_password

# ── Nextcloud ─────────────────────────────────────────────────
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=changeme_nextcloud_password
NEXTCLOUD_DB_PASSWORD=changeme_nextcloud_db_password

# ── Zulip ─────────────────────────────────────────────────────
ZULIP_ADMIN_EMAIL=admin@yourdomain.com
ZULIP_DB_PASSWORD=changeme_zulip_db_password
ZULIP_SECRET_KEY=changeme_64char_random_string_here_zulip
ZULIP_SHARED_SECRET=changeme_zulip_shared_secret
ZULIP_AVATAR_SALT=changeme_zulip_avatar_salt

# ── Matrix / Synapse ──────────────────────────────────────────
SYNAPSE_DB_PASSWORD=changeme_synapse_db_password
MATRIX_REGISTRATION_SECRET=changeme_matrix_registration_secret

# ── Chatwoot ──────────────────────────────────────────────────
CHATWOOT_SECRET_KEY=changeme_64char_random_string_chatwoot
CHATWOOT_DB_PASSWORD=changeme_chatwoot_db_password

# ── Flowise ───────────────────────────────────────────────────
FLOWISE_USERNAME=admin
FLOWISE_PASSWORD=changeme_flowise_password

# ── Open WebUI ────────────────────────────────────────────────
OPEN_WEBUI_SECRET_KEY=changeme_open_webui_secret

# ── ONLYOFFICE ────────────────────────────────────────────────
ONLYOFFICE_JWT_SECRET=changeme_onlyoffice_jwt_secret

# ── Authentik ─────────────────────────────────────────────────
AUTHENTIK_SECRET_KEY=changeme_50char_random_string_authentik
AUTHENTIK_DB_PASSWORD=changeme_authentik_db_password
AUTHENTIK_BOOTSTRAP_EMAIL=admin@yourdomain.com
AUTHENTIK_BOOTSTRAP_PASSWORD=changeme_authentik_admin_password

# ── Headscale ─────────────────────────────────────────────────
# (server_url set in config/headscale/config.yaml)

# ── Plane ─────────────────────────────────────────────────────
PLANE_SECRET_KEY=changeme_50char_random_string_plane
PLANE_DB_PASSWORD=changeme_plane_db_password

# ── ERPNext (MariaDB — separate from main Postgres) ───────────
ERPNEXT_MARIADB_ROOT_PASSWORD=changeme_mariadb_root_password
ERPNEXT_DB_PASSWORD=changeme_erpnext_db_password

# ── Wazuh ─────────────────────────────────────────────────────
WAZUH_INDEXER_PASSWORD=changeme_wazuh_indexer_password
WAZUH_API_PASSWORD=changeme_wazuh_api_password
WAZUH_DASHBOARD_PASSWORD=changeme_wazuh_dashboard_password

# ── Flexprice ─────────────────────────────────────────────────
FLEXPRICE_DB_PASSWORD=changeme_flexprice_db_password
FLEXPRICE_SECRET_KEY=changeme_flexprice_secret

# ── Grafana ───────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_grafana_password
GRAFANA_OAUTH_CLIENT_ID=grafana
GRAFANA_OAUTH_CLIENT_SECRET=changeme_grafana_oauth_secret

# ── Razorpay (for Flexprice + ERPNext) ───────────────────────
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=changeme_razorpay_secret

# ── PayU (optional, for ERPNext) ─────────────────────────────
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
